+ /**
+   ******************************************************************************
+   * @file    tim.c
+-  * @brief   This file provides code for the configuration
+-  *          of the TIM instances.
+-  ******************************************************************************
+-  * @attention
++  * @brief   Bare-metal TIM1 driver: six complementary gate outputs with
++  *          hardware dead time and break input for a three-phase inverter.
+   *
