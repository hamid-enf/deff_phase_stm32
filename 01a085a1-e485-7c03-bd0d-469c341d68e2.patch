++#define ARM_MPU_ATTR_MEMORY_(NT, WB, RA, WA) \
++  ((((NT) & 1U) << 3U) | (((WB) & 1U) << 2U) | (((RA) & 1U) << 1U) | ((WA) & 1U))
++
++/** \brief Device memory type non Gathering, non Re-ordering, non Early Write Acknowledgement */
