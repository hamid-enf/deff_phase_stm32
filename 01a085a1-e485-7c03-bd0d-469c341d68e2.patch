++
++#define CONTROL_nPRIV_Pos                   0U                                            /*!< CONTROL: nPRIV Position */
++#define CONTROL_nPRIV_Msk                  (1UL /*<< CONTROL_nPRIV_Pos*/)                 /*!< CONTROL: nPRIV Mask */
