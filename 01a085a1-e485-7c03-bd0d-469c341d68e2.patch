++  }
++  else if ((mvfr0 & (FPU_MVFR0_FPSP_Msk | FPU_MVFR0_FPDP_Msk)) == 0x020U)
++  {
++    return 1U;           /* Single precision FPU */
++  }
++  else
++  {
++    return 0U;           /* No FPU */
++  }
