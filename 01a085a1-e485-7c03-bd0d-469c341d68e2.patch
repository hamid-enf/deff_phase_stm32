++  \return             Saturated value
++ */
++__attribute__((always_inline)) __STATIC_INLINE uint32_t __USAT(int32_t val, uint32_t sat)
++{
++  if (sat <= 31U)
++  {
++    const uint32_t max = ((1U << sat) - 1U);
++    if (val > (int32_t)max)
++    {
++      return max;
++    }
++    else if (val < 0)
++    {
++      return 0U;
++    }
++  }
++  return (uint32_t)val;
++}
