++
++#define xPSR_T_Pos                         24U                                            /*!< xPSR: T Position */
++#define xPSR_T_Msk                         (1UL << xPSR_T_Pos)                            /*!< xPSR: T Mask */
++
++#define xPSR_GE_Pos                        16U                                            /*!< xPSR: GE Position */
