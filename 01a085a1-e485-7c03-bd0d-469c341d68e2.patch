++__STATIC_INLINE uint32_t __NVIC_GetPendingIRQ(IRQn_Type IRQn)
++{
++  if ((int32_t)(IRQn) >= 0)
++  {
++    return((uint32_t)(((NVIC->ISPR[(((uint32_t)IRQn) >> 5UL)] & (1UL << (((uint32_t)IRQn) & 0x1FUL))) != 0UL) ? 1UL : 0UL));
++  }
++  else
++  {
++    return(0U);
++  }
++}
