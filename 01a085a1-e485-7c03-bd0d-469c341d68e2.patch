++#define GPIO_CFG_INPUT_PU_PD    0x8UL        /*!< input, pull up/down (ODR selects)     */
++#define GPIO_CFG_AF_PP_50MHZ    0xBUL        /*!< alt. function push-pull, 50 MHz       */
