++/* TIM_CR1 */
++#define TIM_CR1_CEN             (1UL << 0)   /*!< Counter enable                        */
++#define TIM_CR1_ARPE            (1UL << 7)   /*!< Auto-reload preload enable            */
++
++/* TIM_DIER / TIM_SR / TIM_EGR */
